        //   '0.0.0.0'
        //   'localhost'
        //   'aaa.bbb.yyy.zzz'
        "bindInterface": "0.0.0.0", 
        "port": 50000,
        "jwt": {
            "enabled": true,
            "audience": "",
            "issuer": "",
            "subject": "",
            "encryption": "",
            "expirationLeeway" : 60,
            "notBeforeLeeway" : 20,
            "publicKey": "",
            "secretKey": ""
        }
    }
}