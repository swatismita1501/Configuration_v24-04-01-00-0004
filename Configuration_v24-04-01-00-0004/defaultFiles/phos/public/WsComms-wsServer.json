{
    "version": {
        "major": 1,
        "minor": 0,
        "patch": 0,
        "full": "1.0.0"
    },
    // Define the connection type
    "connectionType": "server",
	"server": {
        "tls": {
            "enabled": false,
            "certificatePath": "Arc.PFX"
        },
        "inactivityTimeoutMs": 120000,
        "connectionTimeoutMs": 30000,
