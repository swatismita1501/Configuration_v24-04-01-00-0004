{
    "version": {
        "major": 1,
        "minor": 0,
        "patch": 0,
        "full": "1.0.0"
    },
	"hardware": {
		"pcl": {
			// None, Usb, Bluetooth
			"type": "None"
		}
	},
    // Define the connection type
    //   client
    //   server
    "connectionType": "server",
	"client": {
		"tls": {
			"enabled": false,
			"registrationCertificatePath": "terminal_client.bks",
			"connectionCertificatePath": "terminal_client.bks"
		},
		"registration": {
			"url": "ws://192.168.1.79:50002",
			"timeoutMs": 3000,
			"customData": {
				"user": "userOne",
				"password": "123456"
			}
		},
		"connection": {
			"enableRandomInterval": true,
			"timeoutMs": 3000,
			"reconnectInterval": {
				"minimumMs": 1000,
				"maximumMs": 3000,
				"retries": 50
			}
		},
		"pingPong": {
			"enabled": false,
			"pingInterval": {
				"timeoutMs": 10000,
				"timeoutMissedMs": 3000,
				"retries": 10
			}
		}
	},	
	"ipc": {
        "inactivityTimeoutMs": 120000,
        "connectionTimeoutMs": 30000,
        "maxNumberOfConnectors": 100,
        "keepAlivePeriodMs":  60000,
        "keepAliveTimeoutMs": 500
	},
	"server": {
		"tls": {
			"enabled": false,
			"certificatePath": "Arc.PFX"
		},
        "inactivityTimeoutMs": 120000,
        "connectionTimeoutMs": 30000,
        // Define bindInterface used for server mode.
        //   '0.0.0.0'
        //   'localhost'
        //   'aaa.bbb.yyy.zzz'
        "bindInterface": "0.0.0.0", 
        "port": 50000,
        "jwt": {
            "enabled": true,
            "audience": "",
            "issuer": "",
            "subject": "",
            "encryption": "",
            "expirationLeeway" : 60,
            "notBeforeLeeway" : 20,
            "publicKey": "",
            "secretKey": ""
        }
    }
}