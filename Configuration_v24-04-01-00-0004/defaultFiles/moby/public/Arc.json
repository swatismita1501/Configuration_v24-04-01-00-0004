        //@config(0019, 0009)
        //  Allow CVM modification by POS.
        "allowCvmModification": "false",
        //@config(0019, 0020)
        //  Allow external AID selection by customer
        "allowExternalAidSelection": "false",
        //@config(0019, 0007)
        //  Enable Interac application selection
        // false = Disabled
        // true  = Enabled
        "allowInterac": "false",
        //@config(0019, 0008)
        //  Enable Domestic VISA Debit application selection
        //  false = Disabled
        //  true  = Enabled
        "allowVisaDebit": "true",
        //@config(0019, 0003)
        //  Application Selection Method
        //  0  if pin pad prompts cardholder to select application via menu
        //     with    subsequent confirmation.
        //  2  if pin pad prompts cardholder to select application via menu,
        //     without subsequent confirmation.
        //  1  if pin pad prompts cardholder to select application via confirmation
        //     starting with highest-priority application(s).
        //  3  if pin pad prompts cardholder to select application via confirmation
        //     starting with highest-priority application(s) but auto-selects
        //     lowest-priority application without subsequent cardholder
        //     confirmation if all other applications declined.
        "applicationSelectionMethod": "2",
        //@config(0019, 0013)
        //  Timeout for authorization response
        //    0 = disabled
        //    1 or greater = time in 1/10ths seconds
        "authorizationResponseTimeoutTenths": "700",
        //@config(0019, 0002)
        // Configures how the terminal selects the language for the transaction when the
        // terminal supports more then one language the card requests.
        //   true - the highest priority language is chosen automatically.
        //   false - a menu is shown asking the user to chose one of the matched languages.
        "autoSelectLanguage": "true",
        // Configures how the terminal selects the language for the transaction when none
        // of the languages the card requests are supported by the terminal.
        //   true - the terminal's configured default language is chosen automatically.
        //   false - a menu is shown asking the user to chose one of the terminal languages.
        "autoSelectLanguageFallback": "true",
