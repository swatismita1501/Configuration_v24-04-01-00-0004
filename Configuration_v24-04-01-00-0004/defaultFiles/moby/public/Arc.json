    },
    "moby": {
        // Inactivity time after which Moby device enters energy saver mode.
        // Valid range is 10 - 60.
        "energySaverTimeSeconds": "10",
        // Inactivity time after which the Moby device turns off.
        // Valid range is 0 - 300, where 0 means never turn off automatically.
        "shutdownModeTimeSeconds": "180",
        // Time allowed for a card to be tapped, inserted or swiped after starting a card read.
        // Valid range is 0 to 180, where 0 means infinite timeout.
        // Warning: The "shutdownModeTimeSeconds" config still applies.
