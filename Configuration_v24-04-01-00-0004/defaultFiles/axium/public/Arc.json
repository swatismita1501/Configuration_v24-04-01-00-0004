        // Controls the state of the hardware power button.
        // The valid values are:
        //        enabled - The power button is permanently enabled.
        //        disabled - The power button is permanently disabled.
        //        disabledOnCardReaderEnable - The power button is disabled when a card read command begins until the transaction ends.
        //        disabledInTransaction - The power button will be disabled:
        //         - During a contact EMV transaction from the time the card is inserted until the card is removed
        //             and the 33.05 is delivered.
        //         - During a contactless EMV transaction from the time of the tap until the 33.05 is delivered.
        //         - During the manual entry process.
        "powerButton": "disabledInTransaction",
        "screen": {
            // Controls when ARC will automatically return the screen to full brightness from either dim or locked.
            // The valid values are:
            //      never - ARC never changes screen brightness. User must tap screen or use power buttons.
            //      onUiEcrCommand - ARC will restore the screen whenever a UI command is received from the ECR
            // For EFT, this means 20, 21, 23, 24, 25, 27, 31, 35, 70 or 87.
            //      onAnyEcrCommand - ARC will restore the screen whenever any command is received from the ECR.
            "autoScreenOn": "onUiEcrCommand",
            // The number of seconds of inactivity after which the terminal will shift from full brightness to dim.
            // The valid range in seconds should be 30 - 600 (10 minutes) or 0 meaning never dim.
            // WARNING: The use of value 0 (never dim) on a terminal with a battery is not advised due to both
            //    power consumption and overheating.
            "dimTimeoutSec": "30",
            // The number of seconds of inactivity after which the terminal will shift from dim to off (locked).
