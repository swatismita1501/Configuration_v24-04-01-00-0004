    "cashback": {
        //@config(0002, 0004-0007)
        //  Cash back softkey 1-4 amount (in cents)
        "cashbackChoice1": "2000",
        "cashbackChoice2": "4000",
        "cashbackChoice3": "8000",
        "cashbackChoice4": "10000",
        //@config(0002, 0009)
        //  Cash back amount increment (in cents)
        "incrementValue": "1000",
        //@config(0002, 0001)
        //  Max cash back value (in cents), overall value for all card types.
        //  or amount in card configuration table
        "maxCashback": "999999"
    },
    "cless": {
        //@config(0008, 0008)
        //  Duration to display "bad read" error
        //  0 = disabled
        //  1 or greater = time in 1/10ths seconds. Limit is 150 (15 seconds).
        "badReadTimeoutMs": "10",
        //@config(0008, 0003)
        //  Beep when Contactless card read
        "beep": "true",
        //@config(0008, 0010)
        //  Delay time in milliseconds for a Contactless event. Used to prevent a
        //  Contactless event from occurring when using a MSR swipe with a Contactless card.
        //  0 = No delay
        //  1ms to 2000ms = Delay
        "delay": "1000",
        "emv": {
            //  Allow external AID selection by customer
            "allowExternalAidSelection": "false",
            //@config(0008, 0024)
            //  Enable/Disable optimized quick chip
            "optimizedQuickChipEnabled": "false",
            //@config(0008, 0013)
            //  Status Update Steps
            //    c - Contactless online PIN entry
            //    r - Online authorization
            //    u - Transaction completed
            "statusUpdateSteps": "",
            //@config(0008, 0012)
            //  Suspend Steps
            //    c - Contactless online PIN entry
            //    r - Online authorization
            //    u - Transaction completed
            "suspendSteps": "",
            //  Enable/Disable VpTT requirements
            "vptt": "false"
        },
        //@config(0008, 0001)
        //  Contactless supported modes:
        //    0 = disabled
        //    9 = EMV first, PPSE second
        "mode": "9",
        //@config(0008, 0025)
        //  Online Authorization Prompt Id
        "onlineAuthorizationPromptId": "309",
        "result": {
            //@config(0007, 0023)
            //  After display Approved/Disapproved message timeout
            //    0 = Reset
            //    1 = Go to advertising (ads must be enabled)
            //    2 = Wait for reset (displayApprovedDisapproved should be set to 1)
            "actionAfterDisplay": "1",
            //@config(0007, 0022)
            //  Display Approved/Disapproved message timer
            //    0 = Do not display
            //    1 = Display until a reset is received
            //    2 or greater = Time in 1/10th of second (50 = 5 seconds)
            "displayMode": "50"
        },
        //  Supported Payment Types
        //    0 = None
        //    1 = Emv
        //    2 = Mifare
        //    3 = EmvAndMifare
        "supportedPaymentTypes": "3",
        "transactionTypeOverride": {
            //@config(0008, 0021)
            //  Credit contactless void return transaction type
            "creditVoidRefund": "00",
            //@config(0008, 0020)
            //  Credit contactless void sale transaction type
            "creditVoidSale": "00",
            //@config(0008, 0019)
            //  Debit  contactless void return transaction type
            "debitVoidRefund": "02",
            //@config(0008, 0018)
            //  Debit  contactless void sale transaction type
            "debitVoidSale": "22"
        },
        // Image shows on Read Cards form when terminal has NFC antenna under the screen.
        "readCardsImageName": "contactless_card_symbol",
        // Option to decline a transaction when the cless floor limit is set to 0 and the card decides to
        // approve offline. When "true" this setting prevents a fraud case for the Visa kernel.
        //   true = Decline the transaction despite the card decision
        //   false = Accept the card decision and approve the transaction
        "declineIfZeroFloorLimitAndTc": "true",
        // Controls CLESS LED
        //   true = Enable
        //   false = Disable
        "ledEnabled": "false"
    },
    "emv": {
        "aids": {
            //@config(0021, 0001 - 0032)
            //  AID
            //         ||||||||||||||||
            //         |||||||||||||||| Tag 8A value for bad PIN (in hex)
            //         |||||||||||||||| ||  Note: DEPRECATED/UNUSED; use D1011 = 55 if T8A = non-standard value
            //         |||||||||||||||| ||
            //         |||||||||||||||| || Allow PIN bypass
            //         |||||||||||||||| || |                 0 = PIN bypass not allowed
            //         |||||||||||||||| || |                 1 = Enter  Key PIN bypass allowed
            //         |||||||||||||||| || |                 2 = Cancel Key PIN bypass allowed
            //         |||||||||||||||| || | AID Brand
            //         |||||||||||||||| || | ||              1 = Mastercard
            //         |||||||||||||||| || | ||              2 = Visa
            //         |||||||||||||||| || | ||              3 = Interac
            //         |||||||||||||||| || | ||              4 = Amex
            //         |||||||||||||||| || | ||              5 = Discover
            //         |||||||||||||||| || | ||              6 = DNA (US Debit)
            //         |||||||||||||||| || | ||              7 = UnionPay
            //         |||||||||||||||| || | ||              8 = JCB
            //         |||||||||||||||| || | ||              9 = EFTPOS
            //         |||||||||||||||| || | ||             10 = CB
            //         |||||||||||||||| || | ||
            //         |||||||||||||||| || | || US Common debit AID
            //         |||||||||||||||| || | || |            0 =       Non Debit or
            //         |||||||||||||||| || | || |                   Global Debit AID
            //         |||||||||||||||| || | || |            1 = US Common Debit AID
            //         |||||||||||||||| || | || |
            //         |||||||||||||||| || | || | Force cashback
            //         |||||||||||||||| || | || | |          0 = prompt cashback based on AUC cashback bits
            //         |||||||||||||||| || | || | |          1 = force  cashback;  ignore AUC cashback bits
            //         |||||||||||||||| || | || | |
            //         |||||||||||||||| || | || | | PAN consistency check
            //         |||||||||||||||| || | || | | |        Test if primary account number in T57 (Track 2 Equivalent
            //         |||||||||||||||| || | || | | |        Data) is consistent with T5A (Primary Account Number)
            //         |||||||||||||||| || | || | | |
            //         |||||||||||||||| || | || | | |        Note:
            //         |||||||||||||||| || | || | | |        This check currently applies to contactless ONLY.
            //         |||||||||||||||| || | || | | |
            //         |||||||||||||||| || | || | | |        0 = disable check for consistency
            //         |||||||||||||||| || | || | | |        1 = enable  check for consistency
            //         |||||||||||||||| || | || | | |
            //         |||||||||||||||| || | || | | | Allow CLESS PIN bypass
            //         |||||||||||||||| || | || | | | |      0 = PIN bypass not allowed
            //         |||||||||||||||| || | || | | | |      1 = Enter  Key PIN bypass allowed
            //         |||||||||||||||| || | || | | | |      2 = Cancel Key PIN bypass allowed
            //         |||||||||||||||| || | || | | | |
            //         |||||||||||||||| || | || | | | | PIN bypass Cashback
            //         |||||||||||||||| || | || | | | | |    0 = do NOT allow cashback for PIN bypass
            //         |||||||||||||||| || | || | | | | |    1 =        allow cashback for PIN bypass
            //         |||||||||||||||| || | || | | | | |
            //         |||||||||||||||| || | || | | | | | Offline  PIN  Cashback
            //         |||||||||||||||| || | || | | | | | |    0 = do NOT allow cashback for offline PIN CVM
            //         |||||||||||||||| || | || | | | | | |    1 =        allow cashback for offline PIN CVM
            //         |||||||||||||||| || | || | | | | | |
            //         |||||||||||||||| || | || | | | | | | Online PIN  Cashback
            //         |||||||||||||||| || | || | | | | | | |    0 = do NOT allow cashback for online  PIN CVM
            //         |||||||||||||||| || | || | | | | | | |    1 =        allow cashback for online  PIN CVM
            //         |||||||||||||||| || | || | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | Signature Cashback
            //         |||||||||||||||| || | || | | | | | | | |    0 = do NOT allow cashback for signature CVM
            //         |||||||||||||||| || | || | | | | | | | |    1 =        allow cashback for signature CVM
            //         |||||||||||||||| || | || | | | | | | | |    (Note: Discover cards support signature cashback.)
            //         |||||||||||||||| || | || | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | No CVM  Cashback
            //         |||||||||||||||| || | || | | | | | | | | |    0 = do NOT allow cashback for no CVM
            //         |||||||||||||||| || | || | | | | | | | | |    1 =        allow cashback for no CVM
            //         |||||||||||||||| || | || | | | | | | | | |    (Note: no known cards support no CVM cashback.)
            //         |||||||||||||||| || | || | | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | | CLESS EMV Refund, Void, Void-Return Option
            //         |||||||||||||||| || | || | | | | | | | | | |    This indicates how refund, void,
            //         |||||||||||||||| || | || | | | | | | | | | |    void-return is processed.
            //         |||||||||||||||| || | || | | | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | | |    0 - Partial EMV transaction.
            //         |||||||||||||||| || | || | | | | | | | | | |    1 - Full    EMV transaction.
            //         |||||||||||||||| || | || | | | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | | | Optimized QuickChip
            //         |||||||||||||||| || | || | | | | | | | | | | |    0 = Do NOT allow Optimized QuickChip
            //         |||||||||||||||| || | || | | | | | | | | | | |    1 =        allow Optimized QuickChip
            //         |||||||||||||||| || | || | | | | | | | | | | |    (Note: Not all brands support QuickChip.)
            //         |||||||||||||||| || | || | | | | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | | | | Online PIN Key Index
            //         |||||||||||||||| || | || | | | | | | | | | | | |    *   - Use PIN Index from 0006_0008
            //         |||||||||||||||| || | || | | | | | | | | | | | |    0-5 - Use specific key index
            //         |||||||||||||||| || | || | | | | | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | | | | | Contact EMV Refund, Void, Void-Return Option
            //         |||||||||||||||| || | || | | | | | | | | | | | | |    This indicates how refund, void,
            //         |||||||||||||||| || | || | | | | | | | | | | | | |    void-return is processed.
            //         |||||||||||||||| || | || | | | | | | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | | | | | |    0 - Partial EMV transaction.
            //         |||||||||||||||| || | || | | | | | | | | | | | | |    1 - Full    EMV transaction.
            //         |||||||||||||||| || | || | | | | | | | | | | | | |
            //         |||||||||||||||| || | || | | | | | | | | | | | | | PIN Prompt (prompt index from string.xml - must be a prompt valid for PIN)
            //         |||||||||||||||| || | || | | | | | | | | | | | | | 0 = default PIN message
            //         |||||||||||||||| || | || | | | | | | | | | | | | | otherwise one of 1, 3, 14-19, 21-37, 50-52
            //         |||||||||||||||| || | || | | | | | | | | | | | | | ||
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || CLESS PIN Bypass TVR Update
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || |    0 - TVR Byte 3 will indicate Online PIN Entered
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || |    1 - TVR Byte 3 will indicate PIN not Entered
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || |    (Note: Not applicable for Visa and UnionPay AIDs)
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || |
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || | CLESS PIN Bypass CVM fallback
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || | |    0 - No CVM fallback
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || | |    1 - CVM fallback to "No CVM"
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || | |    (Note: Only applicable to Mastercard AIDs.)
            //         |||||||||||||||| || | || | | | | | | | | | | | | | || | |
            "aid.01": "A0000000031010   55 0 02 0 0 1 0 0 0 1 0 0 0 1 * 0  0 0 0",
