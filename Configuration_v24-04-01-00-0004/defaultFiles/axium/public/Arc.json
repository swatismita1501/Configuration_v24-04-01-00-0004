    "mac": {
        "encryption": {
            // Configures the MAC algorithm used for DUKPT MACing.
            //   Retail = Use the Retail algorithm, also known as TDES algorithm 3.
            //   CBC    = Use the CBC algorithm.
            "dukptAlgorithm": "Retail",
            //@config(0016, 0001)
            //  MAC key index (0-9)
            "keyIndex": "0",
            //@config(0016, 0002)
            //  MAC encryptionMethod
            //    0 = Master/Session
            //    1 = DUKPT
            "type": "1"
        },
        //@config(0016, 0003)
        //  Maximum number of transactions with the same key
        //    0 = Set to default, key changes after 10 transactions
        //    1 - 9 = Change key after this many transactions with the same key
        //  macKeyUpdatePeriod is applicable only for DUKPT key types
        "updateKeyAfterNTransactions": "0",
        // Indicates if the full MAC value should be returned in the response.
        // If true, the full MAC value will  be append at the end of the response after an [FS] separator.
        "returnFullMacValue": "false"
