        // Controls the state of the navigation bar.
        // The valid values are:
        //        enabled - The navigation bar is permanently enabled.
        //        disabled - The navigation bar is permanently disabled.
        //        disabledOnCardReaderEnable - The navigation bar is disabled when a card read command begins until the transaction ends.
        //        disabledInTransaction - The navigation bar will be disabled:
        //         - During a contact EMV transaction from the time the card is inserted until the card is removed
        //             and the 33.05 is delivered.
        //         - During a contactless EMV transaction from the time of the tap until the 33.05 is delivered.
        //         - During the manual entry process.
        "navigationBar": "disabledInTransaction",
