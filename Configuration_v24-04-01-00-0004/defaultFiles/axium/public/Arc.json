        //@config(0006, 0004)
        //  Allow 0 length PINs.
        //    true = A valid PIN must be entered
        //    false = Either an empty or valid PIN must be entered
        "allowZeroLengthPin": "false",
        "encryption": {
            //@config(0006, 0008)
            //  Encryption key index (0-9)
            "keyIndex": "0",
            //@config(0006, 0007)
