        //@config(0019, 0009)
        //  Allow CVM modification by POS.
        "allowCvmModification": "false",
        //@config(0019, 0020)
        //  Allow external AID selection by customer
        "allowExternalAidSelection": "false",
        //@config(0019, 0007)
        //  Enable Interac application selection
        // false = Disabled
        // true  = Enabled
        "allowInterac": "false",
        //@config(0019, 0008)
        //  Enable Domestic VISA Debit application selection
        //  false = Disabled
        //  true  = Enabled
        "allowVisaDebit": "true",
        //@config(0019, 0003)
        //  Application Selection Method
        //  0  if pin pad prompts cardholder to select application via menu
        //     with    subsequent confirmation.
        //  2  if pin pad prompts cardholder to select application via menu,
        //     without subsequent confirmation.
        //  1  if pin pad prompts cardholder to select application via confirmation
        //     starting with highest-priority application(s).
        //  3  if pin pad prompts cardholder to select application via confirmation
        //     starting with highest-priority application(s) but auto-selects
        //     lowest-priority application without subsequent cardholder
        //     confirmation if all other applications declined.
        "applicationSelectionMethod": "2",
